# ── Geteilt zwischen beiden Bots (derselbe Discord-Server) ──────────────
GUILD_ID=
BOT_TIMEZONE=Europe/Vienna

# ── TW-Counter ────────────────────────────────────────────────────────
DISCORD_TOKEN=
SPECIALIST_ROLE_ID=
MEMBER_ROLE_ID=
MANAGER_IDS=
OWNER_ID=
ANTHROPIC_API_KEY=
COMLINK_APP_NAME=tw-counter-bot

# ── TB-Reminder ───────────────────────────────────────────────────────
TB_DISCORD_TOKEN=
# TB_CHANNEL_ID: TB-Kanal (tb-territorialschlacht) -- Startnachricht, generische
# Erinnerung, Pings (früher TW_CHANNEL_ID, umbenannt). ORG_CHANNEL_ID: rote-organisation -- Auswahl-Dialoge und
# Bot-Hinweise (ersetzt OFFICER_ID, das entfällt).
TB_CHANNEL_ID=
ORG_CHANNEL_ID=
TB_MANAGER_IDS=
TB_MEMBER_ROLE_ID=

# Nicht hier gesetzt, sondern hart in docker-compose.yml (Container-
# Topologie, kein Deployment-Konfigwert):
#   DATA_DIR        (pro Service auf /app/data)
#   COMLINK_URL      (tw-counter -> http://comlink:3000)
#   ROSTER_DB_PATH   (tb-reminder -> /app/roster-data/counters.db, read-only)
